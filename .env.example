# 复制为 .env 后填写；不要提交 .env。环境变量优先，修改后重启网页。
DEEPSEEK_API_KEY=
# 总开关默认关闭；开启后网页仍须打开 AI 开关（或CLI --allow-api）才会调用。
DEEPSEEK_API_ENABLED=false
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CONNECT_TIMEOUT=5
DEEPSEEK_TIMEOUT=30
# 每日估算预算（人民币元）；不是账户级硬限额，也不是官方账单。
DEEPSEEK_DAILY_BUDGET_CNY=2
# 可选：覆盖估算单价（元/百万token）；不填使用项目内置快照。
# DEEPSEEK_PRICE_INPUT_CNY_PER_M=2
# DEEPSEEK_PRICE_OUTPUT_CNY_PER_M=8
# DEEPSEEK_PRICE_CACHE_HIT_CNY_PER_M=0.04
DEEPSEEK_MAX_OUTPUT_TOKENS=1000
DEEPSEEK_MAX_INPUT_CHARS=16000
# 不再读取请求次数上限；费用由每日预算保护，失败/未知用量保留保护预留。
